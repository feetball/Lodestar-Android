<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Map tiles and place search when you add an observing site. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WorkManager (the widget refresh) asks for this; Lodestar never runs foreground work. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />

    <!-- Every hardware feature is optional, so that Play offers the app on any device (a budget tablet may lack an accelerometer,
         a camera with autofocus or network location). Without the sensors, Aim reports them as unavailable. The permissions above
         and the portrait lock below imply camera.autofocus, location.network and screen.portrait as required unless declared here. -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <!-- Without a magnetometer, Aim runs in Gyro Lock and the heading comes from star alignment. -->
    <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <application
        android:name=".app.LodestarApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lodestar">
        <!-- Portrait on phones, as on iPhone: the phone is clamped to the camera in any orientation, so the UI stays
             put and the Aim HUD counter-rotates its text instead. Large screens may rotate (handled by ScreenAxes). -->
        <activity
            android:name=".app.MainActivity"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets: Tonight at a glance, in two sizes of the widget picker. -->
        <receiver
            android:name=".features.widget.TonightWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_tonight_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tonight_widget_info" />
        </receiver>
        <receiver
            android:name=".features.widget.TonightSmallWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_tonight_small_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tonight_small_widget_info" />
        </receiver>
    </application>

</manifest>
