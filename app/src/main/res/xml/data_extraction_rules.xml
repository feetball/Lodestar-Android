<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: only the settings file (preferences, saved sites, favourites) is backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="lodestar.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="lodestar.xml" />
    </device-transfer>
</data-extraction-rules>
